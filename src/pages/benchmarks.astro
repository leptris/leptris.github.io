---
import BaseLayout from '~/components/BaseLayout.astro';
import BenchBars from '~/components/BenchBars.vue';
import Callout from '~/components/Callout.astro';
import { SITE } from '~/data/site';

const cParseBlocks = [
  {
    title: '2 MB text-heavy DOM parse — vs pugixml, C harness',
    sub: 'median of interleaved runs, identical Release flags, same machine',
    chip: '3.4× vs pugixml',
    rows: [
      { who: 'leptris', val: '193 µs', w: 29.1 },
      { who: 'pugixml', val: '663 µs', w: 100, them: true },
    ],
  },
];

const rubyBlocks = [
  {
    title: 'Real-world document, 4.38 MB — parse + serialize, through Ruby',
    sub: '10,000 records, pretty-printed, encoding-declared; same process, same harness (serialbench)',
    chip: '6.8× vs nokogiri',
    rows: [
      { who: 'leptris', ver: 'via binding', val: '18 ms', w: 14.6 },
      { who: 'Ox', ver: 'C extension', val: '118 ms', w: 95.9, them: true },
      { who: 'Nokogiri', ver: 'libxml2', val: '123 ms', w: 100, them: true },
    ],
  },
];

const pyBlocks = [
  {
    title: 'Parse — 12 KB medium document, through Python',
    sub: 'leptris 1.6.1 (C accelerator), libleptris 1.3.0 — Python 3.10.5, macOS arm64, lxml 6.0.2',
    chip: '8× vs lxml',
    rows: [
      { who: 'leptris', val: '15.2 µs', w: 12.6 },
      { who: 'lxml', ver: 'libxml2', val: '121.0 µs', w: 100, them: true },
    ],
  },
  {
    title: 'The three that used to lose — leptris 1.6.1 vs lxml',
    sub: 'cost accounting found the whole gap was Python object construction; the ~180-line abi3 accelerator closed it',
    chip: '9/9 operations',
    rows: [
      { who: 'leptris //book', ver: '100 elems', val: '6.4 µs', w: 53 },
      { who: 'lxml //book', ver: '100 elems', val: '12.0 µs', w: 100, them: true },
      { who: 'leptris union', ver: '200 elems', val: '19.2 µs', w: 69 },
      { who: 'lxml union', ver: '200 elems', val: '27.9 µs', w: 100, them: true },
      { who: 'leptris traversal', ver: '401 elems', val: '18.0 µs', w: 83 },
      { who: 'lxml traversal', ver: '401 elems', val: '21.6 µs', w: 100, them: true },
    ],
  },
];
---

<BaseLayout
  title="Benchmarks — leptris"
  description="The full race, per language: leptris vs libxml2 and pugixml in C/C++, vs Nokogiri, Ox, and Oga in Ruby, and the Python field (lxml, ElementTree) — with the losses recorded alongside the wins."
>
  <section class="page-head">
    <div class="wrap">
      <p class="sec-label">Benchmarks</p>
      <h1 class="sec-title">The race, <em>per language</em></h1>
      <p class="sec-lede">
        Three audiences, three fields. Embedded C and C++ developers race
        against libxml2 and pugixml. Ruby developers weigh Nokogiri, Ox, and
        Oga. Python developers live with lxml and the stdlib. Every number
        below reproduces from a published harness — wins and losses both.
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="callout" style="margin-top:2.4rem">
      <p>
        <strong>Methodology.</strong> Interleaved A/B runs, median reported,
        fresh Release builds, identical flags and machine. The C harness
        builds with <code>-DLEPTRIS_BUILD_BENCHMARKS=ON</code> and CI uploads
        JSON + Markdown results on every push. Where a number is historical,
        its version is labeled. Nothing is cherry-picked.
      </p>
    </div>
  </div>

  <!-- ————— 01 C / C++ ————— -->
  <section class="sec sec-tint-periwinkle" data-ghost="01" id="c" style="padding-bottom:4rem">
    <div class="wrap">
      <p class="sec-label" data-num="01">Compiled — C and C++</p>
      <h2 class="sec-title">The embedder&rsquo;s race: <em>libxml2 and pugixml</em></h2>
      <p class="sec-lede">
        <strong>libxml2</strong> is the de facto standard — C, everywhere,
        and the engine under Chrome, Firefox, and Python&rsquo;s lxml.
        <strong>pugixml</strong> is C++ and the acknowledged speed king of
        DOM parsing: zero-copy, superb cache locality. Those are the two to
        beat, and the ones we gate against in CI.
      </p>

      <h3>Parse and SAX throughput — vs libxml2</h3>
      <table class="doc-table">
        <tr><th>benchmark</th><th>leptris</th><th>libxml2</th><th>advantage</th></tr>
        <tr><td>SAX small (~1 KB)</td><td class="bytes">2.8 µs (377 MB/s)</td><td class="bytes">7.1 µs (124 MB/s)</td><td class="note">2.5× faster</td></tr>
        <tr><td>SAX medium (~5 KB)</td><td class="bytes">7.5 µs (624 MB/s)</td><td class="bytes">26.9 µs (175 MB/s)</td><td class="note">3.6× faster</td></tr>
        <tr><td>DOM parse (~5 KB)</td><td class="bytes">33 µs</td><td class="bytes">47 µs</td><td class="note">1.4× faster</td></tr>
      </table>

      <h3>DOM read access — vs libxml2</h3>
      <table class="doc-table">
        <tr><th>benchmark</th><th>leptris</th><th>libxml2</th><th>advantage</th></tr>
        <tr><td>Attribute lookup by name</td><td class="bytes">1.6 µs</td><td class="bytes">3.0 µs</td><td class="note">1.9× faster</td></tr>
        <tr><td>Text content extraction</td><td class="bytes">1.4 µs</td><td class="bytes">3.5 µs</td><td class="note">2.6× faster</td></tr>
        <tr><td>Indexed child access (1000 × 50)</td><td class="bytes">2.3 µs (O(1) cached)</td><td class="bytes">2.5 µs</td><td class="note">9% faster</td></tr>
      </table>

      <div class="reveal" style="margin:2.6rem 0">
        <BenchBars client:visible blocks={cParseBlocks} />
      </div>

      <h3>DOM writes and serialization — vs pugixml</h3>
      <table class="doc-table">
        <tr><th>benchmark</th><th>leptris</th><th>pugixml</th><th>verdict</th></tr>
        <tr><td>Set 2000 attributes (duplicate-rejecting)</td><td class="bytes">347 µs</td><td class="bytes">~8–14 ms (find+set)</td><td class="note">~25× faster</td></tr>
        <tr><td>Serialize attr-heavy 2 MB</td><td class="bytes">490 µs</td><td class="bytes">799 µs</td><td class="note">1.6× faster</td></tr>
        <tr><td>Serialize text-heavy 2 MB</td><td class="bytes">566 µs</td><td class="bytes">521 µs</td><td class="note">1.1× slower — parity within noise</td></tr>
        <tr><td>Append 10000 children</td><td class="bytes">160 µs</td><td class="bytes">119 µs</td><td class="note">1.3× slower — the cost of the O(1) duplicate-rejecting index</td></tr>
      </table>

      <h3>XPath — vs libxml2</h3>
      <p>
        leptris leads on <strong>all ten</strong> XPath benchmarks, from the
        per-call floor (<code>self::*</code>, 1.6×) to attribute lookups
        (<code>attribute::id</code>, <strong>4.0×</strong>) and counted
        predicates (<code>count(//book[@id='b1'])</code>, 2.7×). Since
        v1.1.2, union dedup is ~140× faster on large merged sets. The full
        table: <a href="/docs/xpath">the XPath page</a>.
      </p>

      <Callout>
        <p>
          <strong>Apples-to-apples on whitespace.</strong> leptris keeps
          whitespace-only text nodes by default (libxml2/Nokogiri behavior);
          pugixml discards them. For a fair parse race on pretty-printed
          documents use <code>LEPTRIS_PARSE_DROP_WS_TEXT</code> — that flag
          is the entire gap on whitespace-heavy shapes.
        </p>
      </Callout>

      <p class="docs-canonical" style="margin-top:2rem">
        Reproduce: <code>cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DLEPTRIS_BUILD_BENCHMARKS=ON</code>,
        then the binaries under <code>build/benchmarks/</code>.
        <a href={`${SITE.githubC}/tree/main/benchmarks`}>The harness, in the tree</a>.
      </p>
    </div>
  </section>

  <!-- ————— 02 Ruby ————— -->
  <section class="sec sec-tint-rose" data-ghost="02" id="ruby" style="padding-bottom:4rem">
    <div class="wrap">
      <p class="sec-label" data-num="02">Interpreted — Ruby</p>
      <h2 class="sec-title">The migrant&rsquo;s race: <em>Nokogiri, Ox, Oga, REXML</em></h2>
      <p class="sec-lede">
        <strong>Nokogiri</strong> (libxml2 C extension) is the incumbent most
        of you are migrating from. <strong>Ox</strong> (C extension) is the
        raw-parse speed demon — with no XPath engine. <strong>Oga</strong>
        and <strong>REXML</strong> are the pure-Ruby tier: dependency-free,
        and paying the interpreter tax for it. leptris&rsquo; pitch in this
        field: Ox-level (and better) parse speed <em>with</em> complete
        XPath 1.0 — 438/438 — and no libxml2.
      </p>

      <div class="reveal" style="margin:0 0 2.6rem">
        <BenchBars client:visible blocks={rubyBlocks} />
      </div>

      <h3>Operation matrix — vs Nokogiri <span class="pill">libleptris v0.12.0, Apple M1</span></h3>
      <table class="doc-table">
        <tr><th>operation</th><th>leptris</th><th>Nokogiri</th><th>verdict</th></tr>
        <tr><td>Parse small (431 B)</td><td class="bytes">~6 µs</td><td class="bytes">~14 µs</td><td class="note">~2× faster</td></tr>
        <tr><td>Parse medium (12 KB)</td><td class="bytes">~32 µs</td><td class="bytes">~200 µs</td><td class="note">~6× faster</td></tr>
        <tr><td>XPath <code>count(//book)</code></td><td class="bytes">~1.5 µs</td><td class="bytes">~9 µs</td><td class="note">~6× faster</td></tr>
        <tr><td>XPath <code>//book</code> (100 nodes)</td><td class="bytes">~4 µs</td><td class="bytes">~13 µs</td><td class="note">~5× faster</td></tr>
        <tr><td>XPath <code>//book[@id='50']</code></td><td class="bytes">~6 µs</td><td class="bytes">~80 µs</td><td class="note">~10× faster</td></tr>
        <tr><td>XPath <code>//book[price &gt; 50]</code></td><td class="bytes">~80 µs</td><td class="bytes">~100 µs</td><td class="note">~1.3× faster</td></tr>
        <tr><td>XPath union <code>//author | //title</code></td><td class="bytes">~14 µs</td><td class="bytes">~25 µs</td><td class="note">~3× faster</td></tr>
        <tr><td>Serialize</td><td class="bytes">~28 µs</td><td class="bytes">~85 µs</td><td class="note">~3× faster</td></tr>
        <tr><td>Tree traversal</td><td class="bytes">~900 µs</td><td class="bytes">~500 µs</td><td class="note">1.8× slower — the one loss, tracked</td></tr>
      </table>
      <p>
        <strong>8 of 9 operations.</strong> Tree traversal still loses to
        Nokogiri&rsquo;s native iterator; closing it is on the ledger.
      </p>

      <h3>The memoization arc <span class="pill">gem 1.9.2 → 1.9.17, committed harness</span></h3>
      <p>
        Gem-internal before/after on the read paths — same machine, same
        loops, the <a href={`${SITE.githubRuby}/blob/main/benchmark/read_paths.rb`}>committed harness</a>:
        every number below is a published-gem A/B, not a dev-tree run.
      </p>
      <table class="doc-table">
        <tr><th>loop (300-element readonly doc)</th><th>gem 1.9.2</th><th>gem 1.9.17</th><th>verdict</th></tr>
        <tr><td>namespace inspection</td><td class="bytes">0.62 s</td><td class="bytes">0.017 s</td><td class="note">36× faster</td></tr>
        <tr><td>attribute reads</td><td class="bytes">0.63 s</td><td class="bytes">0.048 s</td><td class="note">13× faster</td></tr>
        <tr><td>text content reads</td><td class="bytes">0.19 s</td><td class="bytes">0.035 s</td><td class="note">5× faster</td></tr>
      </table>
      <table class="doc-table">
        <tr><th>loop (writable document — the DOM-editing shape)</th><th>gem 1.9.13</th><th>gem 1.9.14</th><th>verdict</th></tr>
        <tr><td>namespace inspection</td><td class="bytes">0.37 s</td><td class="bytes">0.013 s</td><td class="note">29× faster — readonly parity, via the mutation-version cache</td></tr>
        <tr><td>children iteration</td><td class="bytes">0.15 s</td><td class="bytes">0.014 s</td><td class="note">11× faster — readonly parity</td></tr>
      </table>
      <table class="doc-table">
        <tr><th>single-node query loop</th><th>before</th><th>after</th><th>verdict</th></tr>
        <tr><td><code>at_xpath</code> (2000 iterations)</td><td class="bytes">0.011 s</td><td class="bytes">0.0045 s</td><td class="note">2.5× — container-free seam</td></tr>
        <tr><td><code>at_css</code></td><td class="bytes">0.036 s</td><td class="bytes">0.020 s</td><td class="note">1.8×</td></tr>
      </table>
      <p>
        The design notes live in the repo&rsquo;s
        <a href={`${SITE.githubRuby}/blob/main/docs/adr/`}>ADR set</a> —
        the versioned cache (0003) records the rejected shared-stamp
        variant alongside the shipped per-field stamps.
      </p>

      <h3>The wider field <span class="pill">documented at gem v1.0.0</span></h3>
      <p>
        Historical context for the tier below Nokogiri — measured when the
        binding was young; the engine has since gained the contiguous arena,
        fused scans, and the XPath VM, so treat these as relative order, not
        current numbers:
      </p>
      <table class="doc-table">
        <tr><th>parser</th><th>parse 10 KB</th><th>XPath <code>//book</code></th><th>deps</th><th>notes</th></tr>
        <tr><td><strong>Ox</strong></td><td class="bytes">2.4 µs</td><td class="bytes">— none</td><td class="note">C extension</td><td class="note">fastest raw parse, no XPath engine</td></tr>
        <tr><td><strong>leptris</strong></td><td class="bytes">5.87 µs</td><td class="bytes">9.0 µs</td><td class="note">none</td><td class="note">complete XPath 1.0; ~18% FFI overhead documented</td></tr>
        <tr><td><strong>Nokogiri</strong></td><td class="bytes">10.0 µs</td><td class="bytes">3.87 µs</td><td class="note">libxml2</td><td class="note">the incumbent</td></tr>
        <tr><td><strong>Oga</strong></td><td class="bytes">15.0 µs</td><td class="bytes">~300 µs</td><td class="note">none</td><td class="note">pure Ruby — the interpreter tax, ~77× on XPath</td></tr>
        <tr><td><strong>REXML</strong></td><td class="bytes">—</td><td class="bytes">—</td><td class="note">stdlib</td><td class="note">pure Ruby, same tier as Oga; not in the harness yet</td></tr>
      </table>

      <h3>Memory, same field</h3>
      <table class="doc-table">
        <tr><th>parser</th><th>parse + DOM, 100 KB doc</th><th>relative</th></tr>
        <tr><td>Ox</td><td class="bytes">165 KB</td><td class="note">baseline</td></tr>
        <tr><td>leptris</td><td class="bytes">173 KB</td><td class="note">+5%</td></tr>
        <tr><td>Nokogiri</td><td class="bytes">222 KB</td><td class="note">+35%</td></tr>
      </table>

      <p class="docs-canonical" style="margin-top:2rem">
        Reproduce: <code>bundle exec ruby -Ilib benchmark/leptris_vs_nokogiri.rb</code>.
        <a href={`${SITE.githubRuby}/blob/main/docs/PERFORMANCE.md`}>Full performance guide in leptris-ruby</a>.
      </p>
    </div>
  </section>

  <!-- ————— 03 Python ————— -->
  <section class="sec sec-tint-sage" data-ghost="03" id="python" style="padding-bottom:4rem">
    <div class="wrap">
      <p class="sec-label" data-num="03">Interpreted — Python</p>
      <h2 class="sec-title">The incumbent&rsquo;s race: <em>lxml and the stdlib</em></h2>
      <p class="sec-lede">
        <strong>lxml</strong> is the incumbent — a C extension over the very
        same libxml2 Nokogiri wraps. <strong>xml.etree.ElementTree</strong>
        ships with Python (C-accelerated via <code>_elementtree</code>);
        <strong>xml.dom.minidom</strong> is the pure-Python floor. Since
        1.6.1, leptris <strong>beats lxml on every operation</strong> in the
        matrix — and ships five cp39-abi3 wheels plus sdist on PyPI, so
        <code>pip install leptris</code> is the whole setup.
      </p>

      <div class="reveal" style="margin:0 0 2.6rem">
        <BenchBars client:visible blocks={pyBlocks} />
      </div>

      <h3>Final scoreboard <span class="pill">leptris 1.6.1 — Python 3.10, macOS arm64, lxml 6.0.2, libleptris 1.3.0</span></h3>
      <table class="doc-table">
        <tr><th>operation</th><th>leptris</th><th>lxml</th><th>margin</th></tr>
        <tr><td>Parse medium (12 KB)</td><td class="bytes">15.2 µs</td><td class="bytes">121 µs</td><td class="note">8× faster</td></tr>
        <tr><td>XPath <code>//book[@id='50']</code></td><td class="bytes">3.8 µs</td><td class="bytes">37 µs</td><td class="note">10× faster</td></tr>
        <tr><td>XPath <code>count(//book)</code></td><td class="bytes">1.7 µs</td><td class="bytes">8.1 µs</td><td class="note">4.7× faster</td></tr>
        <tr><td>XPath <code>//book[price &gt; 50]</code></td><td class="bytes">9.7 µs</td><td class="bytes">52 µs</td><td class="note">5.3× faster</td></tr>
        <tr><td>Serialize</td><td class="bytes">18.4 µs</td><td class="bytes">67 µs</td><td class="note">3.7× faster</td></tr>
        <tr><td>XPath <code>//book</code> (100 elems)</td><td class="bytes">6.4 µs</td><td class="bytes">12.0 µs</td><td class="note">1.9× faster — the morning&rsquo;s loss, gone by evening</td></tr>
        <tr><td>XPath union (200 elems)</td><td class="bytes">19.2 µs</td><td class="bytes">27.9 µs</td><td class="note">1.5× faster</td></tr>
        <tr><td>Traversal (401 elems)</td><td class="bytes">18.0 µs</td><td class="bytes">21.6 µs</td><td class="note">1.2× faster — was 15× behind two releases ago</td></tr>
      </table>
      <p>
        <strong>How the last three fell.</strong> Cost accounting showed the
        entire remaining gap was Python object construction — about
        0.10 µs per <code>Element</code>. The 1.6.0 release moved allocation
        into a ~180-line abi3 C accelerator: 0.026 µs per element, with the
        whole API surface still in Python, attached onto the C heap type, and
        a tested pure-Python fallback (<code>LEPTRIS_PURE=1</code>) for
        toolchain-less installs. Wheels ship it compiled for macOS
        arm64/x86_64, manylinux x86_64/aarch64 (built natively on arm
        runners), and Windows.
      </p>

      <p class="docs-canonical" style="margin-top:2rem">
        Reproduce: <code>LEPTRIS_LIB_PATH=…/libleptris.dylib python3
        benchmarks/matrix.py</code> in
        <a href={`${SITE.githubPy}`}>leptris-py</a> — same fixtures and
        operations as the Ruby matrix, and it runs in CI (the C repo&rsquo;s
        <code>python-benchmark</code> workflow); its artifacts are the
        canonical numbers.
      </p>
    </div>
  </section>

  <!-- ————— ledger ————— -->
  <section class="sec" id="ledger">
    <div class="wrap">
      <p class="sec-label" data-num="04">The ledger of losses</p>
      <h2 class="sec-title">Where leptris <em>loses</em> today</h2>
      <p class="sec-lede">
        A speed page that only lists wins is marketing. These are the
        measured deficits, each with a reason and a tracking note — the same
        ledger the repository keeps.
      </p>
      <table class="doc-table">
        <tr><th>race</th><th>deficit</th><th>why</th></tr>
        <tr><td>Attr-heavy parse vs pugixml</td><td class="bytes">~1.5×</td><td class="note">the parse wall: single-pass is at a compiler-global optimum; ~1.5–1.8× behind on this shape, no remaining known lever</td></tr>
        <tr><td>Raw child append vs pugixml</td><td class="bytes">1.3×</td><td class="note">doc-level index bookkeeping — the price of O(1) duplicate-rejecting attribute sets at scale</td></tr>
        <tr><td>Text-heavy serialize vs pugixml</td><td class="bytes">1.1×</td><td class="note">parity within run noise</td></tr>
        <tr><td>Tree traversal vs Ox (Ruby)</td><td class="bytes">~2×</td><td class="note">Ox&rsquo;s native C walk holds the crown across the whole Ruby field — the one place it still wins anything</td></tr>
        <tr><td>Formerly lost, since won</td><td class="bytes">—</td><td class="note">Python <code>//book</code>, union, and traversal — and Ruby traversal vs Nokogiri — all fell to the batch-accessor and accelerator sprints; the tombstones stay in the repos&rsquo; perf ledgers (32 B split-stream attrs, two-pass SIMD parse, and friends)</td></tr>
      </table>
    </div>
  </section>
</BaseLayout>
