---
import Logo from './Logo.astro';
import { SITE, VERSIONS } from '~/data/site';
---

<footer class="footer">
  <div class="wrap">
    <p class="track" aria-hidden="true"><i></i><i></i><i></i></p>
    <p class="foot-tagline">fast as hares · contained as a circle</p>
  </div>
  <div class="wrap">
    <Logo size={26} alt="leptris" />
    <span>libleptris — MIT license · v{VERSIONS.lib}</span>
    <span class="sep">❧</span>
    <span>gem v{VERSIONS.gem} · py v{VERSIONS.py}</span>
    <span class="sep">❧</span>
    <a href={SITE.githubC}>github.com/leptris/leptris</a>
    <span class="sep">❧</span>
    <span class="formerly">formerly taurus</span>
  </div>
</footer>
