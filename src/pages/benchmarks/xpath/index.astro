---
import BaseLayout from '~/components/BaseLayout.astro';
import Matrix from '~/components/bench/Matrix.astro';
import Provenance from '~/components/bench/Provenance.astro';
import ResultsTable from '~/components/bench/ResultsTable.astro';
import { CAMPAIGNS, frontierFor, type Campaign } from '~/data/benchmarks';

const campaign = (id: string): Campaign => {
  const found = CAMPAIGNS.find((c) => c.id === id);
  if (!found) throw new Error(`unknown campaign ${id}`);
  return found;
};

const xmlCLanes = campaign('xml-c-lanes-2026-09-12');
const xmlRuby = campaign('xml-ruby-2026-09-12');
const xmlPython = campaign('xml-python-2026-09-12');

const xpathRows = (c: Campaign) =>
  c.results
    .filter((r) => r.tech === 'xpath')
    .map((result) => ({ result, campaign: c }));

const deficits = frontierFor({ only: ['xpath'] });
---

<BaseLayout
  title="XPath benchmarks — leptris"
  description="XPath 1.0 evaluation: libleptris versus libxml2 in C, and through the Ruby and Python bindings against Nokogiri and lxml — simple paths, predicates, aggregates, unions and variable-bound expressions."
>
  <section class="page-head">
    <div class="wrap">
      <p class="sec-label"><a href="/benchmarks/">Benchmarks</a> · XPath 1.0</p>
      <h1 class="sec-title">XPath <em>evaluation</em></h1>
      <p class="sec-lede">
        The XPath engine implements all thirteen axes, the twenty-seven
        core functions and the fifteen operators of XPath 1.0, and passes
        the complete W3C test suite with 438 of 438 cases. The
        measurements below cover evaluation cost through the C API and
        through both bindings, on the same medium-size fixture across
        languages.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:1.6rem">
    <div class="wrap">
      <Matrix tech="xpath" />
    </div>
  </section>

  <section class="sec sec-tint-periwinkle lang-sec" id="c">
    <div class="wrap">
      <p class="sec-label">C and C++</p>
      <h2 class="sec-title">libleptris versus <em>libxml2</em></h2>
      <p class="sec-lede">
        Five expression shapes are measured on a medium-size document:
        a simple path, a predicate, an aggregate function call, a complex
        predicate, and a union. Both engines evaluate the identical
        expression against the identical parsed document in the same
        process.
      </p>
      <ResultsTable rows={xpathRows(xmlCLanes)} competitorHead="libxml2 2.9.13" />
      <Provenance campaign={xmlCLanes} />
      <p class="docs-canonical">
        To reproduce: build the benchmark targets as described on the
        <a href="/benchmarks/xml/#c">XML page</a> and run the
        <code>bench_xpath_*</code> binaries.
      </p>
    </div>
  </section>

  <section class="sec sec-tint-rose lang-sec" id="ruby">
    <div class="wrap">
      <p class="sec-label">Ruby</p>
      <h2 class="sec-title">The leptris gem versus <em>Nokogiri</em></h2>
      <p class="sec-lede">
        The same five expression shapes, measured through the Ruby API.
        The predicate form is the widest margin because Nokogiri
        re-evaluates the predicate through its full expression pipeline
        for every candidate node.
      </p>
      <ResultsTable rows={xpathRows(xmlRuby)} competitorHead="nokogiri 1.19.4" />
      <Provenance campaign={xmlRuby} />
    </div>
  </section>

  <section class="sec sec-tint-sage lang-sec" id="python">
    <div class="wrap">
      <p class="sec-label">Python</p>
      <h2 class="sec-title">The leptris package versus <em>lxml</em></h2>
      <p class="sec-lede">
        The Python matrix includes two additional shapes: a
        variable-bound predicate, which exercises the compiled-evaluation
        path with external variables, and a namespaced nodeset query.
      </p>
      <ResultsTable rows={xpathRows(xmlPython)} competitorHead="lxml 6.0.2" />
      <Provenance campaign={xmlPython} />
    </div>
  </section>

  <section class="sec" id="deficits">
    <div class="wrap">
      <p class="sec-label">XPath</p>
      <h2 class="sec-title">Measured <em>deficits</em></h2>
      <p class="sec-lede">
        Every XPath operation in the result data that remains behind its
        competitor. There are none at present; this section remains in
        place because it is generated from the same result files as the
        tables above and will list any deficit that a future measurement
        records.
      </p>
      {deficits.length > 0 && <ResultsTable rows={deficits} competitorHead="versus" />}
    </div>
  </section>
</BaseLayout>

<style>
  .lang-sec {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
</style>
