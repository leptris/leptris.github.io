---
import BaseLayout from '~/components/BaseLayout.astro';
import Logo from '~/components/Logo.astro';
---

<BaseLayout title="Not found — leptris" description="The hares chased this page out of the circle.">
  <section class="sec" style="padding:6rem 0">
    <div class="wrap" style="text-align:center">
      <p class="track" aria-hidden="true"><i></i><i></i><i></i></p>
      <div class="orbit">
        <Logo size={90} alt="leptris" />
      </div>
      <h1 class="sec-title" style="margin-top:1.6rem">The hares ran off with this page</h1>
      <p class="sec-lede" style="margin:0 auto 2rem">
        Nothing lives outside the circle. Try the front page, or the docs.
      </p>
      <div class="hero-actions">
        <a class="btn solid" href="/">Home</a>
        <a class="btn" href="/docs">Docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
