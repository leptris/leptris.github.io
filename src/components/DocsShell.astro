---
import { DOCS_NAV } from '~/data/site';

interface Props {
  title: string;
  lede: string;
  crumb: string;
}

const { title, lede, crumb } = Astro.props;
const current = Astro.url.pathname;
---

<section class="page-head">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/docs">Docs</a>
      <span>/</span>
      <span aria-current="page">{crumb}</span>
    </nav>
    <h1 class="sec-title">{title}</h1>
    <p class="sec-lede">{lede}</p>
  </div>
</section>

<div class="docs-layout">
  <nav class="docs-nav" aria-label="Docs">
    <p class="docs-nav-label">Guides</p>
    <ul>
      {DOCS_NAV.map((entry) => (
        <li>
          <a href={entry.href} aria-current={current === entry.href ? 'page' : undefined}>
            {entry.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="docs-nav-label">Reference</p>
    <ul>
      <li><a href="/benchmarks">Benchmarks</a></li>
      <li><a href="/changelog">Changelog</a></li>
      <li><a href="/about">About the mark</a></li>
    </ul>
    <nav class="docs-toc" aria-label="On this page" hidden>
      <p class="docs-nav-label">On this page</p>
      <ol id="docs-toc-list"></ol>
    </nav>
  </nav>
  <div class="prose docs-prose">
    <slot />
    <div class="docs-canonical">
      <p>
        <strong>This is the curated guide.</strong> The repositories are canonical:
        when this page and the repo disagree, the repo wins. Full documentation
        lives with the source.
      </p>
    </div>
  </div>
</div>

<script>
  const prose = document.querySelector('.docs-prose');
  const toc = document.querySelector<HTMLElement>('.docs-toc');
  const list = document.getElementById('docs-toc-list');
  if (prose && toc && list) {
    const heads = Array.from(prose.querySelectorAll('h2'));
    if (heads.length > 1) {
      heads.forEach((h, i) => {
        if (!h.id) h.id = `sec-${i + 1}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = (h.textContent ?? '').trim();
        li.appendChild(a);
        list.appendChild(li);
      });
      toc.hidden = false;
    }
  }
</script>
